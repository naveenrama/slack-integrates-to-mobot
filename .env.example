# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# OAuth (CIMD)
# CIMD_METADATA_URL: Host public/oauth-client-metadata.json at any public URL and put it here.
# Options: S3, GitHub Pages, Cloudflare Pages, any static host.
# This URL becomes your client_id — Sumo Logic fetches it server-to-server.
CIMD_METADATA_URL=https://your-public-host/.well-known/oauth-client-metadata.json

# Callback runs locally — no ngrok needed (browser redirect, not server-to-server)
OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback

# Storage
TOKEN_STORE_BACKEND=sqlite
SQLITE_DB_PATH=./mobot.db

# Token encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# App
LOG_LEVEL=DEBUG
POLL_INTERVAL_SECONDS=1.0
POLL_TIMEOUT_SECONDS=120.0
